  {"said_in": "Apr 2026", "metric": "EBIT margin", "promise": "Margin aspiration of 16-17%, up from 15.6% in FY26", "quote": "Our aspiration continues to be in the 16 to 17% range.", "outcome": "Operating margin fell from 19% (Mar 2026) to 16% (Jun 2026) and 14% (Sep 2026).", "verdict": "pending", "evidence": "No end date was given, but the trend is the wrong way: three points of operating-margin compression in two quarters. Guidance is EBIT margin, reported here is EBITDA margin, so the gap to 16-17% EBIT is wider still."},
  {"said_in": "Apr 2026", "metric": "Cash conversion", "promise": "OCF/PAT (77% in Q4 FY26) to normalise next quarter", "quote": "which we expect to normalize in the next quarter", "outcome": "Quarterly cash flow is not reported in the material; FY26 CFO ₹1,767 cr vs PAT ₹1,865 cr (95%).", "verdict": "pending", "evidence": "Cannot be checked until the FY27 cash-flow statement; annual conversion is healthy (5-year CFO = 101% of PAT)."},
  {"said_in": "Oct 2026", "metric": "One-time costs", "promise": "About $50M of deal expenses over 3-4 quarters, hitting reported profit", "quote": "we are expecting one-time expenses to the tune of approximately $50 million spread over three to four quarters", "outcome": "Sep 2026 PAT dropped to ₹352 cr from ₹483 cr (-27% QoQ) while revenue grew 8%.", "verdict": "partial", "evidence": "The profit hit is showing up as flagged, but PAT fell far more than the ~3.1% deal-cost impact management cited, so operations are also weaker."},
  {"said_in": "Aug 2026", "metric": "Leverage", "promise": "Net debt/EBITDA 1.9-2.5x after the deal, back to 1x by FY2030", "quote": "it is expected to reduce down to 1X by FY2030", "outcome": "Deal not yet closed; D/E is 0.07 as of Sep 2026.", "verdict": "pending", "evidence": "Balance sheet is nearly debt-free today; the €1.4B bridge loan will change that on closing."},
  {"said_in": "Aug 2026", "metric": "M&A", "promise": "Close Nagarro in Q4 CY26 or early Q1 CY27", "quote": "we expect this transaction to close sometime towards the Q4 of Calendar Year 2026 or early Q1 of Calendar Year 2027", "outcome": "Still on that timeline per the Oct 2026 call, awaiting RBI and FDI approvals.", "verdict": "pending", "evidence": "Timeline restated unchanged in October; approvals expected in 4-8 weeks."},
