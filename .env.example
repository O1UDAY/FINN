# Any one LLM key enables the judgement layer; with none, FINN runs rules-only.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# FINN_LLM_PROVIDER=gemini   # force a provider when both keys are set
# Optional: web lookup for incoming executives' backgrounds
TAVILY_API_KEY=
FINN_REFRESH_SECONDS=21600
# Gemini model names (Google retires old names for new keys; change here, no code edit needed)
# FINN_GEMINI_CHEAP=gemini-3.5-flash-lite
# FINN_GEMINI_STRONG=gemini-3.5-flash
